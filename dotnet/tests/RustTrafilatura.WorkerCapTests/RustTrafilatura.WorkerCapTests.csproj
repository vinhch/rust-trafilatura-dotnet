<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- xunit.v3 alone: it carries the Microsoft.Testing.Platform entry point and needs neither the
       VSTest SDK nor the Visual Studio adapter, which are the two packages a VSTest project adds.
       The runner is opted in by global.json and the executable output set here: the shared
       dotnet/Directory.Build.props gates both on the project name ending in ".Tests", which this
       project's name does not, so it sets them for itself. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/RustTrafilatura/RustTrafilatura.csproj" />
  </ItemGroup>

</Project>
